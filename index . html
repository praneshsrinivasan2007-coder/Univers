<script>
(function(){
"use strict";

/* ============================================================
   CONFIG / DATA
=============================================================*/
const COLORS = { cyan:'#37f4e4', purple:'#a768ff', gold:'#ffcf6b' };

const NODE_DATA = [
  { id:'hub', label:'NEXUS CORE', cat:'Cognitive Core', color:COLORS.cyan, hub:true, r:34,
    desc:'Central orchestration model routing inference across every subsystem in the mesh.',
    metrics:[['Throughput','1.2M/s',92],['Confidence','98.4%',98]] },

  { id:'vision', label:'Vision AI', cat:'Data Streams', color:COLORS.purple, r:19, angle:-100,
    desc:'Real-time multimodal perception pipeline processing video and sensor imagery.',
    metrics:[['Accuracy','94.2%',94],['Latency','8ms',82]] },

  { id:'nlp', label:'Language Engine', cat:'Cognitive Core', color:COLORS.cyan, r:19, angle:-40,
    desc:'Transformer cluster handling contextual language understanding and generation.',
    metrics:[['Tokens/s','42.1k',88],['Coherence','96.7%',97]] },

  { id:'robotics', label:'Robotics Grid', cat:'Infrastructure', color:COLORS.gold, r:18, angle:20,
    desc:'Actuator fleet coordination for distributed autonomous units across sectors.',
    metrics:[['Units Online','214',76],['Sync Rate','99.1%',99]] },

  { id:'cloud', label:'Cloud Fabric', cat:'Infrastructure', color:COLORS.gold, r:17, angle:80,
    desc:'Elastic compute substrate distributing model shards across edge regions.',
    metrics:[['Nodes','1,842',81],['Uptime','99.98%',100]] },

  { id:'security', label:'Cyber Sentinel', cat:'Infrastructure', color:COLORS.gold, r:17, angle:140,
    desc:'Adversarial defense layer monitoring intrusion vectors and anomaly signatures.',
    metrics:[['Threats Blocked','1,204',70],['Integrity','100%',100]] },

  { id:'analytics', label:'Data Analytics', cat:'Data Streams', color:COLORS.purple, r:18, angle:-160,
    desc:'Streaming analytics engine surfacing patterns across petabyte-scale datasets.',
    metrics:[['Ingest Rate','3.4TB/h',85],['Anomalies','12',34]] },

  { id:'quantum', label:'Quantum Compute', cat:'Cognitive Core', color:COLORS.cyan, r:17, angle:160,
    desc:'Hybrid quantum-classical co-processor accelerating combinatorial optimization.',
    metrics:[['Qubits','512',64],['Coherence Time','118µs',58]] },

  { id:'iot', label:'IoT Network', cat:'Data Streams', color:COLORS.purple, r:16, angle:-220 + 360,
    desc:'Distributed sensor mesh feeding continuous telemetry into the cognitive core.',
    metrics:[['Devices','48.2k',91],['Packet Loss','0.02%',99]] },
];

const EDGES = [
  ['hub','vision'],['hub','nlp'],['hub','robotics'],['hub','cloud'],
  ['hub','security'],['hub','analytics'],['hub','quantum'],['hub','iot'],
  ['vision','analytics'],['nlp','quantum'],['robotics','cloud'],
  ['security','cloud'],['analytics','iot'],['vision','nlp']
];

const ICONS = {
  hub:'◈', vision:'◎', nlp:'✎', robotics:'⚙', cloud:'☁', security:'🛡', analytics:'▤', quantum:'✦', iot:'∴'
};

/* ============================================================
   CANVAS SETUP
=============================================================*/
const canvas = document.getElementById('network-canvas');
const ctx = canvas.getContext('2d');
let W, H, DPR;

function resize(){
  DPR = Math.min(window.devicePixelRatio || 1, 2);
  W = window.innerWidth; H = window.innerHeight;
  canvas.width = W * DPR; canvas.height = H * DPR;
  canvas.style.width = W+'px'; canvas.style.height = H+'px';
  ctx.setTransform(DPR,0,0,DPR,0,0);
}
window.addEventListener('resize', resize);
resize();

/* ---- Layout: place nodes around hub ---- */
const RADIUS = Math.min(window.innerWidth, window.innerHeight) * 0.28;
NODE_DATA.forEach(n=>{
  if(n.hub){ n.bx=0; n.by=0; return; }
  const a = (n.angle||0) * Math.PI/180;
  n.bx = Math.cos(a) * RADIUS;
  n.by = Math.sin(a) * RADIUS * 0.72;
  n.phase = Math.random()*Math.PI*2;
});
const nodeMap = {}; NODE_DATA.forEach(n=>nodeMap[n.id]=n);

/* ---- Ambient background particles (dust) ---- */
const dust = [];
for(let i=0;i<90;i++){
  dust.push({
    x:(Math.random()-0.5)*2200, y:(Math.random()-0.5)*1600,
    r:Math.random()*1.6+0.4, vx:(Math.random()-0.5)*0.06, vy:(Math.random()-0.5)*0.06,
    a:Math.random()*0.5+0.15, hue: Math.random()<0.5?COLORS.cyan:(Math.random()<0.5?COLORS.purple:COLORS.gold)
  });
}

/* ---- Edge travel particles ---- */
const flowParticles = EDGES.map((e,i)=>({
  edge:e, t: Math.random(), speed: 0.15+Math.random()*0.2, dir: Math.random()<0.5?1:-1
}));

/* ============================================================
   VIEW STATE (pan/zoom)
=============================================================*/
const view = { x:0, y:0, scale:1 };
let dragging=false, dragStart={x:0,y:0}, viewStart={x:0,y:0};
let dragMoved=false;

function screenToWorld(sx,sy){
  return { x:(sx - W/2 - view.x)/view.scale, y:(sy - H/2 - view.y)/view.scale };
}
function worldToScreen(wx,wy){
  return { x: W/2 + view.x + wx*view.scale, y: H/2 + view.y + wy*view.scale };
}
function clampScale(s){ return Math.max(0.4, Math.min(2.6, s)); }
function updateZoomLabel(){ document.getElementById('zoom-level').textContent = Math.round(view.scale*100)+'%'; }
function updateCoordRead(){
  document.getElementById('coordread').textContent =
    `x:${view.x.toFixed(0)}  y:${view.y.toFixed(0)}  scale:${view.scale.toFixed(2)}`;
}

canvas.addEventListener('pointerdown', e=>{
  dragging=true; dragMoved=false; canvas.classList.add('dragging');
  dragStart={x:e.clientX,y:e.clientY}; viewStart={x:view.x,y:view.y};
  canvas.setPointerCapture(e.pointerId);
});
canvas.addEventListener('pointermove', e=>{
  if(!dragging) return;
  const dx=e.clientX-dragStart.x, dy=e.clientY-dragStart.y;
  if(Math.abs(dx)+Math.abs(dy) > 3) dragMoved=true;
  view.x = viewStart.x+dx; view.y = viewStart.y+dy;
  updateCoordRead();
});
canvas.addEventListener('pointerup', e=>{
  dragging=false; canvas.classList.remove('dragging');
  if(!dragMoved){ handleClick(e.clientX, e.clientY); }
});
canvas.addEventListener('pointerleave', ()=>{ dragging=false; canvas.classList.remove('dragging'); });

canvas.addEventListener('wheel', e=>{
  e.preventDefault();
  const factor = e.deltaY<0 ? 1.08 : 0.93;
  const before = screenToWorld(e.clientX, e.clientY);
  view.scale = clampScale(view.scale*factor);
  const after = worldToScreen(before.x, before.y);
  view.x += e.clientX - after.x; view.y += e.clientY - after.y;
  updateZoomLabel(); updateCoordRead();
},{passive:false});

document.getElementById('zoom-in').onclick = ()=> zoomBy(1.2);
document.getElementById('zoom-out').onclick = ()=> zoomBy(0.83);
document.getElementById('zoom-fit').onclick = ()=>{ view.x=0; view.y=0; view.scale=1; updateZoomLabel(); updateCoordRead(); };
function zoomBy(f){
  const cx=W/2, cy=H/2;
  const before = screenToWorld(cx,cy);
  view.scale = clampScale(view.scale*f);
  const after = worldToScreen(before.x,before.y);
  view.x += cx-after.x; view.y += cy-after.y;
  updateZoomLabel(); updateCoordRead();
}
document.getElementById('btn-reset').onclick = ()=>{ view.x=0; view.y=0; view.scale=1; updateZoomLabel(); updateCoordRead(); };

/* pinch zoom (touch) */
let pinchDist=null;
canvas.addEventListener('touchstart', e=>{
  if(e.touches.length===2){ pinchDist = touchDist(e.touches); }
},{passive:true});
canvas.addEventListener('touchmove', e=>{
  if(e.touches.length===2 && pinchDist){
    const d = touchDist(e.touches);
    const f = d/pinchDist;
    view.scale = clampScale(view.scale*f);
    pinchDist = d;
    updateZoomLabel();
  }
},{passive:true});
canvas.addEventListener('touchend', e=>{ if(e.touches.length<2) pinchDist=null; });
function touchDist(t){ const dx=t[0].clientX-t[1].clientX, dy=t[0].clientY-t[1].clientY; return Math.sqrt(dx*dx+dy*dy); }

/* ============================================================
   NODE HIT-TESTING + CLICK -> CARDS
=============================================================*/
let lastScreenPos = {};
function handleClick(sx,sy){
  for(const n of NODE_DATA){
    const p = lastScreenPos[n.id];
    if(!p) continue;
    const rr = (n.r + 6) * view.scale;
    const dx = sx-p.x, dy = sy-p.y;
    if(dx*dx+dy*dy <= rr*rr){ toggleCard(n); return; }
  }
}

const openCards = new Map();
const cardsLayer = document.getElementById('cards-layer');

function toggleCard(n){
  if(openCards.has(n.id)){ closeCard(n.id); return; }
  if(openCards.size >= 3){ const oldest = openCards.keys().next().value; closeCard(oldest); }
  const el = document.createElement('div');
  el.className='card';
  const bars = n.metrics.map(m=>`
      <div class="mrow"><span>${m[0]}</span><b>${m[1]}</b></div>
      <div class="mbar"><i style="width:${m[2]}%;background:${n.color};box-shadow:0 0 8px ${n.color};"></i></div>
  `).join('');
  el.innerHTML = `
    <div class="card-top">
      <div class="card-icon" style="background:${hexA(n.color,0.14)};color:${n.color};border:1px solid ${hexA(n.color,0.4)};">${ICONS[n.id]||'◇'}</div>
      <button class="card-close">✕</button>
    </div>
    <h4>${n.label}</h4>
    <div class="card-cat">${n.cat}</div>
    <p>${n.desc}</p>
    ${bars}
    <div class="status"><span class="pulse"></span>ACTIVE · STREAMING</div>
  `;
  el.querySelector('.card-close').onclick = ()=> closeCard(n.id);
  cardsLayer.appendChild(el);
  openCards.set(n.id, el);
}
function closeCard(id){
  const el = openCards.get(id);
  if(el){ el.remove(); openCards.delete(id); }
}
function hexA(hex,a){
  const c = hex.replace('#','');
  const r=parseInt(c.substr(0,2),16), g=parseInt(c.substr(2,2),16), b=parseInt(c.substr(4,2),16);
  return `rgba(${r},${g},${b},${a})`;
}
function positionCards(){
  let i=0;
  openCards.forEach((el,id)=>{
    const n = nodeMap[id];
    const p = lastScreenPos[id];
    if(!p) return;
    let left = p.x + 26, top = p.y - 20 + i*4;
    if(left + 246 > W) left = p.x - 256;
    if(top + 220 > H - 20) top = H - 240;
    if(top < 80) top = 80;
    el.style.left = left+'px';
    el.style.top = top+'px';
    i++;
  });
}

/* ============================================================
   SEARCH (highlight nodes)
=============================================================*/
let searchTerm = '';
document.getElementById('search-input').addEventListener('input', e=>{
  searchTerm = e.target.value.trim().toLowerCase();
});

/* ============================================================
   SIMULATION CONTROLS
=============================================================*/
let running = true, speed = 1;
const btnPlay = document.getElementById('btn-play');
btnPlay.onclick = ()=>{
  running = !running;
  btnPlay.classList.toggle('active', running);
  document.getElementById('icon-play').innerHTML = running
    ? '<path d="M6 4l14 8-14 8V4z"/>'
    : '<path d="M6 4h4v16H6zM14 4h4v16h-4z"/>';
};
document.querySelectorAll('.speed span').forEach(s=>{
  s.onclick = ()=>{
    document.querySelectorAll('.speed span').forEach(x=>x.classList.remove('on'));
    s.classList.add('on'); speed = parseFloat(s.dataset.speed);
  };
});

/* ============================================================
   RENDER LOOP
=============================================================*/
let t = 0;
function draw(){
  ctx.clearRect(0,0,W,H);
  ctx.save();
  ctx.translate(W/2+view.x, H/2+view.y);
  ctx.scale(view.scale, view.scale);

  // dust
  dust.forEach(d=>{
    ctx.beginPath();
    ctx.fillStyle = hexA(d.hue, d.a);
    ctx.arc(d.x, d.y, d.r, 0, Math.PI*2);
    ctx.fill();
  });

  // edges
  EDGES.forEach(([a,b])=>{
    const na=nodeMap[a], nb=nodeMap[b];
    const pa = nodePos(na), pb = nodePos(nb);
    const grad = ctx.createLinearGradient(pa.x,pa.y,pb.x,pb.y);
    grad.addColorStop(0, hexA(na.color,0.55));
    grad.addColorStop(1, hexA(nb.color,0.55));
    ctx.strokeStyle = grad;
    ctx.lineWidth = 1.1;
    ctx.beginPath(); ctx.moveTo(pa.x,pa.y); ctx.lineTo(pb.x,pb.y); ctx.stroke();
  });

  // flow particles along edges
  flowParticles.forEach(fp=>{
    const na=nodeMap[fp.edge[0]], nb=nodeMap[fp.edge[1]];
    const pa=nodePos(na), pb=nodePos(nb);
    const x = pa.x + (pb.x-pa.x)*fp.t;
    const y = pa.y + (pb.y-pa.y)*fp.t;
    ctx.beginPath();
    ctx.fillStyle = na.color;
    ctx.shadowColor = na.color; ctx.shadowBlur = 8;
    ctx.arc(x,y,2.2,0,Math.PI*2); ctx.fill();
    ctx.shadowBlur = 0;
  });

  // nodes
  NODE_DATA.forEach(n=>{
    const p = nodePos(n);
    const dim = searchTerm && !n.label.toLowerCase().includes(searchTerm) && !n.cat.toLowerCase().includes(searchTerm);
    const match = searchTerm && !dim;

    // outer glow ring
    const pulse = n.hub ? (Math.sin(t*1.4)*0.5+0.5) : (Math.sin(t*1.4+n.phase)*0.5+0.5);
    const ringR = n.r + 8 + pulse*4;
    ctx.beginPath();
    ctx.strokeStyle = hexA(n.color, dim?0.08:(match?0.9:0.35));
    ctx.lineWidth = match?2:1;
    ctx.arc(p.x,p.y,ringR,0,Math.PI*2); ctx.stroke();

    // core
    ctx.beginPath();
    const g = ctx.createRadialGradient(p.x,p.y,0,p.x,p.y,n.r);
    g.addColorStop(0, hexA(n.color, dim?0.15:1));
    g.addColorStop(1, hexA(n.color, dim?0.03:0.25));
    ctx.fillStyle = g;
    ctx.shadowColor = n.color; ctx.shadowBlur = dim?4:(n.hub?36:18);
    ctx.arc(p.x,p.y,n.r,0,Math.PI*2); ctx.fill();
    ctx.shadowBlur = 0;

    // ring border
    ctx.beginPath();
    ctx.strokeStyle = hexA('#ffffff', dim?0.05:0.35);
    ctx.lineWidth=1;
    ctx.arc(p.x,p.y,n.r,0,Math.PI*2); ctx.stroke();

    // label
    ctx.font = (n.hub? '700 12px' : '600 10.5px') + " 'Space Grotesk', sans-serif";
    ctx.fillStyle = dim ? 'rgba(200,220,220,0.15)' : 'rgba(233,247,246,0.92)';
    ctx.textAlign = 'center';
    ctx.fillText(n.label, p.x, p.y + n.r + 16);

    // save screen pos for hit testing/cards
    const sp = worldToScreen(p.x, p.y);
    lastScreenPos[n.id] = sp;
  });

  ctx.restore();
  positionCards();
}

function nodePos(n){
  if(n.hub) return {x:0,y:0};
  const fx = Math.sin(t*0.6 + n.phase) * 10;
  const fy = Math.cos(t*0.5 + n.phase) * 10;
  return { x:n.bx+fx, y:n.by+fy };
}

let lastFrame = performance.now();
function loop(now){
  const dt = Math.min((now-lastFrame)/1000, 0.05);
  lastFrame = now;
  if(running){
    t += dt*speed;
    dust.forEach(d=>{
      d.x += d.vx*speed; d.y += d.vy*speed;
      if(d.x>1100) d.x=-1100; if(d.x<-1100) d.x=1100;
      if(d.y>800) d.y=-800; if(d.y<-800) d.y=800;
    });
    flowParticles.forEach(fp=>{
      fp.t += fp.speed*fp.dir*dt;
      if(fp.t>1){ fp.t=1; fp.dir=-1; }
      if(fp.t<0){ fp.t=0; fp.dir=1; }
    });
  }
  draw();
  requestAnimationFrame(loop);
}
requestAnimationFrame(loop);
updateZoomLabel(); updateCoordRead();

/* ============================================================
   TOP NAV: dropdowns
=============================================================*/
function setupDropdown(btnId, ddId){
  const btn=document.getElementById(btnId), dd=document.getElementById(ddId);
  btn.addEventListener('click', e=>{
    e.stopPropagation();
    const isOpen = dd.classList.contains('open');
    document.querySelectorAll('.dropdown').forEach(d=>d.classList.remove('open'));
    if(!isOpen) dd.classList.add('open');
  });
}
setupDropdown('btn-bell','dd-bell');
setupDropdown('btn-profile','dd-profile');
document.addEventListener('click', ()=> document.querySelectorAll('.dropdown').forEach(d=>d.classList.remove('open')));

document.getElementById('btn-search-mobile').addEventListener('click', e=>{
  e.stopPropagation();
  document.getElementById('navsearch').classList.toggle('open');
});

/* mobile bottom panel toggle */
const aipanel = document.getElementById('aipanel');
document.getElementById('btn-panel-toggle').addEventListener('click', ()=>{
  aipanel.classList.toggle('open');
});

/* ============================================================
   METRICS PANEL
=============================================================*/
const METRICS = [
  { name:'Neural Load', val:74, unit:'%', color:COLORS.cyan },
  { name:'Data Throughput', val:88, unit:'%', color:COLORS.purple },
  { name:'Model Confidence', val:96, unit:'%', color:COLORS.gold },
  { name:'Mesh Sync', val:91, unit:'%', color:COLORS.cyan },
  { name:'Anomaly Score', val:12, unit:'%', color:COLORS.purple },
];
const metricsList = document.getElementById('metrics-list');
METRICS.forEach((m,i)=>{
  const el = document.createElement('div');
  el.className='metric';
  el.innerHTML = `
    <div class="mtop"><span class="mname">${m.name}</span><span class="mval" id="mval-${i}">${m.val}${m.unit}</span></div>
    <div class="track"><div class="fill" id="mfill-${i}" style="width:${m.val}%;background:${m.color};box-shadow:0 0 10px ${hexA(m.color,0.6)};"></div></div>
  `;
  metricsList.appendChild(el);
});
setInterval(()=>{
  METRICS.forEach((m,i)=>{
    let delta = (Math.random()-0.5)*6;
    m.val = Math.max(4, Math.min(99, m.val+delta));
    document.getElementById('mval-'+i).textContent = Math.round(m.val)+m.unit;
    document.getElementById('mfill-'+i).style.width = m.val+'%';
  });
}, 1800);

/* ============================================================
   ALERTS FEED
=============================================================*/
const ALERT_POOL = [
  ['info','Model checkpoint saved to cold storage.'],
  ['info','Vision AI recalibrated on new frame batch.'],
  ['warn','Latency spike detected on Cloud Fabric edge node.'],
  ['info','Language Engine context window expanded.'],
  ['crit','Anomalous traffic pattern flagged by Cyber Sentinel.'],
  ['info','IoT Network absorbed 2,148 new device handshakes.'],
  ['warn','Quantum Compute coherence time dropped 4%.'],
  ['info','Data Analytics cleared backlog queue.'],
  ['info','Robotics Grid completed fleet sync cycle.'],
];
const alertsList = document.getElementById('alerts-list');
const bellList = document.getElementById('dd-bell-list');
let alertCount = 0;
function pushAlert(){
  const [level,text] = ALERT_POOL[Math.floor(Math.random()*ALERT_POOL.length)];
  const time = new Date().toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'});
  const el = document.createElement('div');
  el.className = 'alert-item ' + (level==='warn'?'warn':level==='crit'?'crit':'');
  el.innerHTML = `<span class="atime">${time}</span><span>${text}</span>`;
  alertsList.prepend(el);
  while(alertsList.children.length>8) alertsList.removeChild(alertsList.lastChild);

  alertCount++;
  document.getElementById('alert-count').textContent = alertCount;
  const bellItem = document.createElement('div');
  bellItem.className='dd-item';
  const dotColor = level==='crit'?'#ff5d7a':level==='warn'?'#ffcf6b':'#37f4e4';
  bellItem.innerHTML = `<span class="dot" style="background:${dotColor}"></span><div class="txt"><div>${text}</div><div>${time}</div></div>`;
  bellList.prepend(bellItem);
  while(bellList.children.length>6) bellList.removeChild(bellList.lastChild);
  document.getElementById('bell-badge').textContent = alertCount>9?'9+':alertCount;
}
pushAlert(); pushAlert();
setInterval(pushAlert, 5200);

/* ============================================================
   AI CHAT
=============================================================*/
const chatLog = document.getElementById('chat-log');
const chatInput = document.getElementById('chat-input');
const chatSend = document.getElementById('chat-send');

function addMsg(text, who){
  const el = document.createElement('div');
  el.className = 'msg '+who;
  el.textContent = text;
  chatLog.appendChild(el);
  chatLog.scrollTop = chatLog.scrollHeight;
  return el;
}
addMsg("NEXUS online. Ask me about any subsystem — try “vision” or “quantum”.", 'ai');

const RESPONSES = {
  vision:"Vision AI is running at 94.2% accuracy with 8ms latency across the current frame batch — well within nominal range.",
  nlp:"Language Engine is processing 42.1k tokens/s with 96.7% coherence. No degradation detected.",
  robotics:"Robotics Grid reports 214 units online at 99.1% sync rate. All actuator clusters nominal.",
  cloud:"Cloud Fabric is distributing load across 1,842 nodes at 99.98% uptime.",
  security:"Cyber Sentinel has blocked 1,204 intrusion attempts this cycle. Integrity holding at 100%.",
  analytics:"Data Analytics is ingesting 3.4TB/h with 12 minor anomalies under review.",
  quantum:"Quantum Compute is operating 512 qubits at 118µs coherence time — a slight dip worth monitoring.",
  iot:"IoT Network shows 48.2k active devices with negligible 0.02% packet loss.",
  hub:"The Cognitive Core is orchestrating all eight subsystems at 98.4% confidence, routing 1.2M inferences/sec."
};
function respondTo(text){
  const lower = text.toLowerCase();
  let key = Object.keys(RESPONSES).find(k=> lower.includes(k) || lower.includes(nodeMap[k]?.label.toLowerCase().split(' ')[0]));
  if(key) return RESPONSES[key];
  const generic = [
    "All subsystems are currently within nominal operating parameters.",
    "I'm cross-referencing that against the live mesh telemetry now — nothing anomalous stands out.",
    "Mesh-wide confidence remains above 96%. Let me know which node you'd like me to isolate.",
    "That pattern correlates with a minor load shift on the Cloud Fabric — nothing actionable yet."
  ];
  return generic[Math.floor(Math.random()*generic.length)];
}
function sendChat(){
  const val = chatInput.value.trim();
  if(!val) return;
  addMsg(val,'user');
  chatInput.value='';
  const typingEl = document.createElement('div');
  typingEl.className='msg ai typing';
  typingEl.innerHTML='<span></span><span></span><span></span>';
  chatLog.appendChild(typingEl);
  chatLog.scrollTop = chatLog.scrollHeight;
  setTimeout(()=>{
    typingEl.remove();
    addMsg(respondTo(val),'ai');
  }, 700+Math.random()*700);
}
chatSend.addEventListener('click', sendChat);
chatInput.addEventListener('keydown', e=>{ if(e.key==='Enter') sendChat(); });

})();
