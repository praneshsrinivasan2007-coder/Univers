<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1, user-scalable=no">
<title>NEXUS · Cognitive Mesh</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg-0:#03080a;
    --bg-1:#061217;
    --teal-deep:#07222a;
    --cyan:#37f4e4;
    --cyan-dim:#1aa79e;
    --purple:#a768ff;
    --purple-dim:#6b3fb0;
    --gold:#ffcf6b;
    --gold-dim:#b8912f;
    --text-hi:#e9f7f6;
    --text-mid:#8fb3b6;
    --text-low:#4f6c70;
    --danger:#ff5d7a;
    --glass:rgba(10,24,28,0.55);
    --glass-brd:rgba(120,220,210,0.14);
    --radius:14px;
  }
  *{box-sizing:border-box;}
  html,body{
    margin:0;padding:0;height:100%;width:100%;
    background:radial-gradient(ellipse at 50% 30%, var(--teal-deep) 0%, var(--bg-1) 45%, var(--bg-0) 100%);
    font-family:'Space Grotesk',sans-serif;
    color:var(--text-hi);
    overflow:hidden;
    -webkit-font-smoothing:antialiased;
  }
  ::selection{background:var(--cyan);color:#00201d;}
  ::-webkit-scrollbar{width:6px;height:6px;}
  ::-webkit-scrollbar-thumb{background:var(--cyan-dim);border-radius:4px;}
  ::-webkit-scrollbar-track{background:transparent;}

  /* ---------- Canvas layer ---------- */
  #network-canvas{
    position:fixed;inset:0;width:100%;height:100%;
    cursor:grab;touch-action:none;
  }
  #network-canvas.dragging{cursor:grabbing;}

  .vignette{
    position:fixed;inset:0;pointer-events:none;z-index:2;
    background:
      radial-gradient(ellipse at 50% 50%, transparent 40%, rgba(1,4,5,0.75) 100%);
  }
  .scanlines{
    position:fixed;inset:0;pointer-events:none;z-index:2;opacity:.035;
    background:repeating-linear-gradient(0deg,#fff 0px,#fff 1px,transparent 1px,transparent 3px);
    mix-blend-mode:overlay;
  }

  /* ---------- Top Nav ---------- */
  .topnav{
    position:fixed;top:0;left:0;right:0;z-index:30;
    display:flex;align-items:center;gap:18px;
    padding:14px 22px;
    background:linear-gradient(180deg, rgba(4,10,12,0.82) 0%, rgba(4,10,12,0.35) 100%);
    backdrop-filter:blur(14px);
    border-bottom:1px solid var(--glass-brd);
  }
  .logo{
    display:flex;align-items:center;gap:10px;
    font-family:'Orbitron',sans-serif;
    font-weight:700;letter-spacing:2px;font-size:17px;
    color:var(--text-hi);flex-shrink:0;
    user-select:none;
  }
  .logo .mark{
    width:26px;height:26px;position:relative;flex-shrink:0;
  }
  .logo .mark svg{width:100%;height:100%;display:block;filter:drop-shadow(0 0 6px var(--cyan));}
  .logo .sub{
    font-family:'Space Grotesk',sans-serif;font-weight:400;font-size:9px;letter-spacing:3px;
    color:var(--text-mid);display:block;margin-top:1px;
  }
  .logo-stack{display:flex;flex-direction:column;line-height:1.1;}

  .simctl{
    display:flex;align-items:center;gap:6px;
    background:rgba(255,255,255,0.03);
    border:1px solid var(--glass-brd);
    border-radius:999px;padding:4px;flex-shrink:0;
  }
  .simctl button{
    width:30px;height:30px;border-radius:999px;border:none;
    background:transparent;color:var(--text-mid);
    display:flex;align-items:center;justify-content:center;cursor:pointer;
    transition:all .2s ease;
  }
  .simctl button:hover{color:var(--cyan);background:rgba(55,244,228,0.1);}
  .simctl button.active{background:var(--cyan);color:#00201d;box-shadow:0 0 14px rgba(55,244,228,0.6);}
  .simctl .speed{
    display:flex;gap:3px;padding-left:6px;margin-left:4px;border-left:1px solid var(--glass-brd);
  }
  .simctl .speed span{
    font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--text-low);
    padding:4px 7px;border-radius:999px;cursor:pointer;transition:all .2s;
  }
  .simctl .speed span.on{background:rgba(167,104,255,0.18);color:var(--purple);}

  .navsearch{
    flex:1;max-width:420px;position:relative;
    display:flex;align-items:center;
  }
  .navsearch input{
    width:100%;background:rgba(255,255,255,0.03);
    border:1px solid var(--glass-brd);border-radius:10px;
    padding:9px 14px 9px 36px;color:var(--text-hi);font-size:13px;
    font-family:'Space Grotesk',sans-serif;
    outline:none;transition:border-color .2s, box-shadow .2s;
  }
  .navsearch input:focus{border-color:var(--cyan-dim);box-shadow:0 0 0 3px rgba(55,244,228,0.08);}
  .navsearch input::placeholder{color:var(--text-low);}
  .navsearch svg{position:absolute;left:11px;width:15px;height:15px;stroke:var(--text-low);pointer-events:none;}

  .navright{display:flex;align-items:center;gap:10px;margin-left:auto;flex-shrink:0;}
  .iconbtn{
    width:36px;height:36px;border-radius:10px;border:1px solid var(--glass-brd);
    background:rgba(255,255,255,0.03);color:var(--text-mid);
    display:flex;align-items:center;justify-content:center;cursor:pointer;position:relative;
    transition:all .2s ease;
  }
  .iconbtn:hover{color:var(--cyan);border-color:var(--cyan-dim);background:rgba(55,244,228,0.06);}
  .iconbtn svg{width:17px;height:17px;}
  .badge{
    position:absolute;top:-3px;right:-3px;min-width:15px;height:15px;padding:0 3px;
    background:var(--gold);color:#241a02;font-size:9px;font-weight:700;
    border-radius:999px;display:flex;align-items:center;justify-content:center;
    font-family:'JetBrains Mono',monospace;box-shadow:0 0 8px rgba(255,207,107,0.7);
  }
  .profile{
    display:flex;align-items:center;gap:8px;cursor:pointer;
    padding:4px 10px 4px 4px;border-radius:999px;border:1px solid var(--glass-brd);
    background:rgba(255,255,255,0.03);
  }
  .profile:hover{border-color:var(--purple-dim);}
  .avatar{
    width:28px;height:28px;border-radius:50%;flex-shrink:0;
    background:conic-gradient(from 180deg,var(--cyan),var(--purple),var(--gold),var(--cyan));
    display:flex;align-items:center;justify-content:center;
  }
  .avatar::after{
    content:'';width:22px;height:22px;border-radius:50%;background:var(--bg-1);
  }
  .profile .pname{font-size:12px;color:var(--text-hi);font-weight:500;}
  .profile .prole{font-size:9px;color:var(--text-low);display:block;}

  .dropdown{
    position:absolute;top:calc(100% + 10px);right:0;min-width:230px;
    background:var(--glass);backdrop-filter:blur(20px);
    border:1px solid var(--glass-brd);border-radius:12px;
    padding:8px;opacity:0;visibility:hidden;transform:translateY(-6px);
    transition:all .18s ease;z-index:40;
    box-shadow:0 20px 50px rgba(0,0,0,0.5);
  }
  .dropdown.open{opacity:1;visibility:visible;transform:translateY(0);}
  .dropdown .dd-title{font-size:10px;letter-spacing:1.5px;color:var(--text-low);padding:8px 10px 4px;text-transform:uppercase;}
  .dropdown .dd-item{
    display:flex;gap:10px;align-items:flex-start;padding:9px 10px;border-radius:8px;cursor:pointer;
    transition:background .15s;
  }
  .dropdown .dd-item:hover{background:rgba(255,255,255,0.05);}
  .dropdown .dd-item .dot{width:6px;height:6px;border-radius:50%;margin-top:5px;flex-shrink:0;}
  .dropdown .dd-item .txt div:first-child{font-size:12px;color:var(--text-hi);}
  .dropdown .dd-item .txt div:last-child{font-size:10.5px;color:var(--text-low);margin-top:2px;}
  .dropdown hr{border:none;border-top:1px solid var(--glass-brd);margin:6px 4px;}

  /* ---------- Zoom controls ---------- */
  .zoomctl{
    position:fixed;right:20px;top:50%;transform:translateY(-50%);z-index:25;
    display:flex;flex-direction:column;gap:2px;
    background:var(--glass);backdrop-filter:blur(16px);
    border:1px solid var(--glass-brd);border-radius:12px;overflow:hidden;
  }
  .zoomctl button{
    width:38px;height:38px;border:none;background:transparent;color:var(--text-mid);
    cursor:pointer;font-size:16px;display:flex;align-items:center;justify-content:center;
    transition:all .18s;border-bottom:1px solid var(--glass-brd);
  }
  .zoomctl button:last-child{border-bottom:none;}
  .zoomctl button:hover{color:var(--cyan);background:rgba(55,244,228,0.08);}
  .zoomctl .zlevel{
    font-family:'JetBrains Mono',monospace;font-size:9px;color:var(--text-low);
    text-align:center;padding:5px 0;border-bottom:1px solid var(--glass-brd);
  }

  .legend{
    position:fixed;left:20px;top:90px;z-index:20;
    background:var(--glass);backdrop-filter:blur(16px);
    border:1px solid var(--glass-brd);border-radius:12px;
    padding:12px 14px;font-size:11px;color:var(--text-mid);
    display:flex;flex-direction:column;gap:7px;
  }
  .legend .lg-title{font-size:9px;letter-spacing:2px;color:var(--text-low);text-transform:uppercase;margin-bottom:2px;}
  .legend .lg-row{display:flex;align-items:center;gap:8px;}
  .legend .sw{width:9px;height:9px;border-radius:50%;flex-shrink:0;}

  /* ---------- Floating info cards ---------- */
  .card{
    position:fixed;z-index:35;width:230px;
    background:var(--glass);backdrop-filter:blur(20px);
    border:1px solid var(--glass-brd);border-radius:var(--radius);
    padding:14px;box-shadow:0 20px 60px rgba(0,0,0,0.55);
    animation:cardIn .28s cubic-bezier(.2,.8,.3,1);
  }
  @keyframes cardIn{from{opacity:0;transform:translateY(8px) scale(.96);}to{opacity:1;transform:translateY(0) scale(1);}}
  .card .card-top{display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin-bottom:8px;}
  .card .card-icon{
    width:34px;height:34px;border-radius:9px;display:flex;align-items:center;justify-content:center;
    flex-shrink:0;font-size:16px;
  }
  .card .card-close{
    background:none;border:none;color:var(--text-low);cursor:pointer;font-size:14px;line-height:1;
    padding:2px;
  }
  .card .card-close:hover{color:var(--danger);}
  .card h4{margin:0 0 3px;font-size:13.5px;font-family:'Space Grotesk';color:var(--text-hi);}
  .card .card-cat{font-size:9.5px;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-low);margin-bottom:8px;}
  .card p{font-size:11.5px;line-height:1.5;color:var(--text-mid);margin:0 0 10px;}
  .card .mrow{display:flex;align-items:center;justify-content:space-between;font-size:10px;color:var(--text-low);margin-bottom:4px;}
  .card .mrow b{color:var(--text-hi);font-family:'JetBrains Mono',monospace;font-weight:500;}
  .card .mbar{height:4px;border-radius:3px;background:rgba(255,255,255,0.06);overflow:hidden;margin-bottom:9px;}
  .card .mbar i{display:block;height:100%;border-radius:3px;}
  .card .status{
    display:inline-flex;align-items:center;gap:5px;font-size:9.5px;color:var(--cyan);
    font-family:'JetBrains Mono',monospace;
  }
  .card .status .pulse{width:6px;height:6px;border-radius:50%;background:var(--cyan);box-shadow:0 0 6px var(--cyan);animation:blink 1.4s infinite;}
  @keyframes blink{0%,100%{opacity:1;}50%{opacity:.3;}}

  /* ---------- Bottom AI Panel ---------- */
  .aipanel{
    position:fixed;left:0;right:0;bottom:0;z-index:28;
    background:linear-gradient(180deg, rgba(6,15,18,0.35) 0%, rgba(4,9,11,0.85) 30%, rgba(3,7,9,0.94) 100%);
    backdrop-filter:blur(22px);
    border-top:1px solid var(--glass-brd);
    padding:14px 20px 16px;
    display:grid;grid-template-columns:1.3fr 1fr 1.1fr;gap:16px;
    max-height:44vh;
  }
  .panel-block{
    background:rgba(255,255,255,0.02);border:1px solid var(--glass-brd);border-radius:12px;
    padding:12px 14px;display:flex;flex-direction:column;min-height:0;
  }
  .panel-title{
    font-size:9.5px;letter-spacing:2px;text-transform:uppercase;color:var(--text-low);
    display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;flex-shrink:0;
  }
  .panel-title .live{
    display:flex;align-items:center;gap:5px;color:var(--gold);font-family:'JetBrains Mono',monospace;font-size:9px;
  }
  .panel-title .live .dotlive{width:5px;height:5px;border-radius:50%;background:var(--gold);animation:blink 1.4s infinite;}

  /* Metrics */
  .metrics{display:flex;flex-direction:column;gap:10px;overflow-y:auto;}
  .metric{}
  .metric .mtop{display:flex;justify-content:space-between;font-size:11px;margin-bottom:5px;}
  .metric .mtop .mname{color:var(--text-mid);}
  .metric .mtop .mval{font-family:'JetBrains Mono',monospace;color:var(--text-hi);font-weight:600;}
  .metric .track{height:6px;border-radius:4px;background:rgba(255,255,255,0.05);overflow:hidden;}
  .metric .fill{height:100%;border-radius:4px;transition:width .6s cubic-bezier(.3,.7,.3,1);position:relative;}
  .metric .fill::after{
    content:'';position:absolute;inset:0;
    background:linear-gradient(90deg, transparent, rgba(255,255,255,0.5), transparent);
    animation:sheen 2.2s linear infinite;
  }
  @keyframes sheen{0%{transform:translateX(-100%);}100%{transform:translateX(220%);}}

  /* Alerts */
  .alerts{display:flex;flex-direction:column;gap:7px;overflow-y:auto;}
  .alert-item{
    display:flex;gap:8px;align-items:flex-start;font-size:11px;color:var(--text-mid);
    padding:7px 9px;border-radius:8px;background:rgba(255,255,255,0.02);
    border-left:2px solid var(--cyan-dim);animation:alertIn .3s ease;
  }
  @keyframes alertIn{from{opacity:0;transform:translateX(8px);}to{opacity:1;transform:translateX(0);}}
  .alert-item.warn{border-left-color:var(--gold);}
  .alert-item.crit{border-left-color:var(--danger);}
  .alert-item .atime{font-family:'JetBrains Mono',monospace;font-size:9px;color:var(--text-low);flex-shrink:0;margin-top:1px;}

  /* Chat */
  .chatpanel{display:flex;flex-direction:column;min-height:0;}
  .chat-log{flex:1;overflow-y:auto;display:flex;flex-direction:column;gap:8px;padding-right:2px;margin-bottom:8px;min-height:60px;}
  .msg{max-width:88%;font-size:11.5px;line-height:1.45;padding:8px 11px;border-radius:10px;}
  .msg.user{align-self:flex-end;background:rgba(167,104,255,0.16);border:1px solid rgba(167,104,255,0.3);color:var(--text-hi);border-bottom-right-radius:3px;}
  .msg.ai{align-self:flex-start;background:rgba(55,244,228,0.08);border:1px solid rgba(55,244,228,0.22);color:var(--text-hi);border-bottom-left-radius:3px;}
  .msg.typing{display:flex;gap:4px;align-items:center;padding:10px 12px;}
  .msg.typing span{width:5px;height:5px;border-radius:50%;background:var(--cyan);animation:typing 1s infinite ease-in-out;}
  .msg.typing span:nth-child(2){animation-delay:.15s;}
  .msg.typing span:nth-child(3){animation-delay:.3s;}
  @keyframes typing{0%,60%,100%{opacity:.3;transform:translateY(0);}30%{opacity:1;transform:translateY(-3px);}}
  .chat-inputrow{display:flex;gap:8px;flex-shrink:0;}
  .chat-inputrow input{
    flex:1;background:rgba(255,255,255,0.03);border:1px solid var(--glass-brd);
    border-radius:9px;padding:9px 12px;color:var(--text-hi);font-size:12px;outline:none;
    font-family:'Space Grotesk';transition:border-color .2s;
  }
  .chat-inputrow input:focus{border-color:var(--cyan-dim);}
  .chat-inputrow button{
    width:36px;height:36px;border-radius:9px;border:none;flex-shrink:0;
    background:linear-gradient(135deg,var(--cyan),var(--purple));color:#04141a;
    display:flex;align-items:center;justify-content:center;cursor:pointer;
    box-shadow:0 0 16px rgba(55,244,228,0.35);transition:transform .15s;
  }
  .chat-inputrow button:hover{transform:scale(1.06);}
  .chat-inputrow button svg{width:15px;height:15px;}

  /* panel collapse toggle for mobile */
  .panel-toggle{
    display:none;position:fixed;bottom:0;left:0;right:0;z-index:29;
    justify-content:center;padding:6px 0;
    background:linear-gradient(0deg, rgba(3,7,9,0.9), transparent);
  }
  .panel-toggle button{
    background:var(--glass);border:1px solid var(--glass-brd);color:var(--text-mid);
    border-radius:999px;padding:6px 18px;font-size:10px;letter-spacing:1px;
    display:flex;align-items:center;gap:6px;backdrop-filter:blur(10px);
  }

  /* ---------- Coordinate readout ---------- */
  .coordread{
    position:fixed;left:20px;bottom:calc(44vh + 14px);z-index:20;
    font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--text-low);
    background:var(--glass);backdrop-filter:blur(10px);border:1px solid var(--glass-brd);
    padding:6px 10px;border-radius:8px;
  }

  /* ---------- Responsive ---------- */
  @media (max-width:980px){
    .aipanel{grid-template-columns:1fr;max-height:none;position:fixed;top:0;bottom:0;left:0;right:0;
      padding-top:70px;transform:translateY(100%);transition:transform .3s ease;overflow-y:auto;}
    .aipanel.open{transform:translateY(0);}
    .panel-toggle{display:flex;}
    .legend{display:none;}
    .zoomctl{top:auto;bottom:60px;transform:none;right:14px;}
    .coordread{display:none;}
  }
  @media (max-width:700px){
    .navsearch{position:fixed;top:64px;left:12px;right:12px;max-width:none;
      opacity:0;visibility:hidden;transform:translateY(-6px);transition:all .2s;}
    .navsearch.open{opacity:1;visibility:visible;transform:translateY(0);}
    .simctl .speed{display:none;}
    .profile .pname, .profile .prole{display:none;}
    .profile{padding:4px;}
    .logo .sub{display:none;}
  }
  @media (max-width:480px){
    .simctl{display:none;}
    .topnav{gap:10px;padding:12px 14px;}
  }
</style>
</head>
<body>

<canvas id="network-canvas"></canvas>
<div class="vignette"></div>
<div class="scanlines"></div>

<!-- ============ TOP NAV ============ -->
<nav class="topnav">
  <div class="logo">
    <div class="mark">
      <svg viewBox="0 0 40 40" fill="none">
        <circle cx="20" cy="20" r="4" fill="#37f4e4"/>
        <circle cx="20" cy="20" r="17" stroke="#37f4e4" stroke-width="1.4" stroke-dasharray="3 5"/>
        <circle cx="20" cy="5" r="2.4" fill="#a768ff"/>
        <circle cx="35" cy="20" r="2.4" fill="#ffcf6b"/>
        <circle cx="20" cy="35" r="2.4" fill="#a768ff"/>
        <circle cx="5" cy="20" r="2.4" fill="#ffcf6b"/>
        <line x1="20" y1="20" x2="20" y2="5" stroke="#37f4e4" stroke-width="1"/>
        <line x1="20" y1="20" x2="35" y2="20" stroke="#37f4e4" stroke-width="1"/>
      </svg>
    </div>
    <div class="logo-stack">
      NEXUS
      <span class="sub">COGNITIVE&nbsp;MESH</span>
    </div>
  </div>

  <div class="simctl">
    <button id="btn-play" class="active" title="Play/Pause simulation">
      <svg id="icon-play" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M6 4l14 8-14 8V4z"/></svg>
    </button>
    <button id="btn-reset" title="Reset view">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 1 3 6.7M3 12v6h6"/></svg>
    </button>
    <div class="speed">
      <span data-speed="0.5">0.5×</span>
      <span data-speed="1" class="on">1×</span>
      <span data-speed="2">2×</span>
    </div>
  </div>

  <div class="navsearch" id="navsearch">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.35-4.35"/></svg>
    <input id="search-input" type="text" placeholder="Search nodes, data streams, models…" autocomplete="off">
  </div>

  <div class="navright">
    <button class="iconbtn" id="btn-search-mobile" title="Search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.35-4.35"/></svg>
    </button>

    <div style="position:relative;">
      <button class="iconbtn" id="btn-bell" title="Notifications">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
        <span class="badge" id="bell-badge">3</span>
      </button>
      <div class="dropdown" id="dd-bell">
        <div class="dd-title">Notifications</div>
        <div id="dd-bell-list"></div>
      </div>
    </div>

    <div style="position:relative;">
      <div class="profile" id="btn-profile">
        <div class="avatar"></div>
        <div>
          <span class="pname">Dr. Aris Vane</span>
          <span class="prole">Systems Architect</span>
        </div>
      </div>
      <div class="dropdown" id="dd-profile">
        <div class="dd-title">Account</div>
